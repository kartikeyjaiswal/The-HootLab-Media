/*************************************************************
 *  THE HOOTLAB MEDIA — Form Relay (Google Apps Script)
 *
 *  One endpoint for Brand & Influencer submissions. It fans out to:
 *    1. Google Sheet  (a running log / database)
 *    2. Email         (MailApp — sends from your Google account)
 *    3. WhatsApp       (CallMeBot — free, to your own number)
 *
 *  Later: forward to your existing Google Form (see forwardToGoogleForm).
 *
 *  ── SETUP ────────────────────────────────────────────────
 *  1. Fill in the CONFIG block below.
 *  2. Deploy ▸ New deployment ▸ type "Web app"
 *       - Execute as: Me
 *       - Who has access: Anyone
 *  3. Copy the /exec URL into src/lib/relay.ts (RELAY_URL).
 *  See FORMS-SETUP.md for the full walkthrough.
 *************************************************************/

const CONFIG = {
  // Where email alerts go (your inbox):
  NOTIFY_EMAIL: "contact@thehootlabmedia.com",

  // WhatsApp alerts via GREEN-API — free "Developer" plan (see BACKEND-SETUP.md).
  // Fill these in your OWN deployed copy of the script. Leave blank to skip WhatsApp.
  // NOTE: never commit real values here — this file is public on GitHub.
  GREENAPI_ID_INSTANCE: "YOUR_GREENAPI_INSTANCE_ID",
  GREENAPI_API_TOKEN: "YOUR_GREENAPI_API_TOKEN",
  WHATSAPP_PHONE: "YOUR_WHATSAPP_NUMBER",   // number that receives alerts

  // Google Sheet to log into. Leave "" to auto-create one named below.
  SHEET_ID: "",
  SHEET_NAME: "HootLab Submissions",
};

// Email header logo — embedded INLINE (base64 PNG) so it shows in every email
// client with no dependency on the website being live. Do not edit by hand.
var LOGO_B64 = "";

/** Main entry point — the website POSTs here. */
function doPost(e) {
  try {
    const data = (e && e.parameter) ? e.parameter : {};

    // Honeypot: real users leave "botcheck" empty; bots fill it. Silently drop.
    if (data.botcheck) return json({ success: true });

    const type = (data.form_type || "unknown").toLowerCase();

    logToSheet(type, data);
    sendEmail(type, data);
    sendWhatsApp(type, data);
    // forwardToGoogleForm(type, data);  // ← enable once you send me your Form

    return json({ success: true });
  } catch (err) {
    return json({ success: false, error: String(err) });
  }
}

/** Quick browser test: open the /exec URL to confirm it's live. */
function doGet() {
  return json({ status: "HootLab form relay is live." });
}

/* ── 1. Google Sheet ─────────────────────────────────────── */
function logToSheet(type, data) {
  const ss = CONFIG.SHEET_ID
    ? SpreadsheetApp.openById(CONFIG.SHEET_ID)
    : getOrCreateSpreadsheet();
  const tabName = type === "brand" ? "Brands" : type === "influencer" ? "Influencers" : "Other";
  let sheet = ss.getSheetByName(tabName);
  if (!sheet) sheet = ss.insertSheet(tabName);

  // Header row = timestamp + every field key we received.
  const keys = Object.keys(data).filter((k) => k !== "botcheck");
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(["Timestamp"].concat(keys));
  }
  const header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const row = header.map((h) =>
    h === "Timestamp" ? new Date() : (data[h] !== undefined ? data[h] : "")
  );
  // Add any brand-new keys as columns.
  keys.forEach((k) => {
    if (header.indexOf(k) === -1) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(k);
      row.push(data[k]);
    }
  });
  sheet.appendRow(row);
}

function getOrCreateSpreadsheet() {
  const files = DriveApp.getFilesByName(CONFIG.SHEET_NAME);
  if (files.hasNext()) return SpreadsheetApp.open(files.next());
  return SpreadsheetApp.create(CONFIG.SHEET_NAME);
}

/* ── 2. Email ────────────────────────────────────────────── */
function sendEmail(type, data) {
  if (!CONFIG.NOTIFY_EMAIL) return;

  const isBrand = type === "brand";
  const badge = isBrand ? "New Brand Enquiry" : "New Creator Application";
  const emoji = isBrand ? "🏢" : "🎬";
  const who =
    data.influencer_name ||
    ((data.first_name || "") + " " + (data.last_name || "")).trim() ||
    data.company ||
    "Website visitor";

  // Detail rows — zebra-striped, uppercase labels.
  const rows = Object.keys(data)
    .filter((k) => k !== "botcheck" && k !== "form_type")
    .map((k, i) => {
      const bg = i % 2 ? "#ffffff" : "#f7f8fa";
      return (
        `<tr>` +
        `<td style="padding:11px 16px;background:${bg};color:#5b6577;font:600 11px/1.4 Arial,sans-serif;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;vertical-align:top;border-bottom:1px solid #eef0f3">${prettify(k)}</td>` +
        `<td style="padding:11px 16px;background:${bg};color:#111827;font:400 14px/1.5 Arial,sans-serif;border-bottom:1px solid #eef0f3">${escapeHtml(data[k])}</td>` +
        `</tr>`
      );
    })
    .join("");

  const cta = data.email
    ? `<a href="mailto:${escapeHtml(data.email)}" style="display:inline-block;background:#F5A21A;color:#ffffff;font:700 14px/1 Arial,sans-serif;text-decoration:none;padding:13px 24px;border-radius:999px">Reply to ${escapeHtml(who)}</a>`
    : "";

  const html =
`<!DOCTYPE html><html><body style="margin:0;padding:0;background:#eef1f5">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef1f5;padding:24px 12px">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden">
<tr><td style="background:#082E6D;padding:26px 32px;text-align:center">
<img src="cid:hootlablogo" alt="The HootLab Media" width="200" style="width:200px;max-width:66%;height:auto;display:inline-block;border:0">
</td></tr>
<tr><td style="padding:28px 32px 6px">
<span style="display:inline-block;background:#FEF1DC;color:#B4740A;font:700 11px/1 Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:8px 14px;border-radius:999px">${emoji} ${badge}</span>
<h1 style="margin:16px 0 4px;color:#082E6D;font:700 22px/1.3 Arial,sans-serif">${escapeHtml(who)}</h1>
<p style="margin:0;color:#6b7280;font:400 14px/1.5 Arial,sans-serif">A new ${isBrand ? "brand enquiry" : "creator application"} just came in through your website.</p>
</td></tr>
<tr><td style="padding:16px 32px 6px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #eef0f3;border-radius:12px;overflow:hidden">${rows}</table>
</td></tr>
<tr><td style="padding:10px 32px 28px">${cta}</td></tr>
<tr><td style="background:#f7f8fa;padding:18px 32px;border-top:1px solid #eef0f3;text-align:center">
<p style="margin:0;color:#9aa3af;font:400 12px/1.5 Arial,sans-serif">Sent automatically from <a href="https://thehootlabmedia.com" style="color:#082E6D;text-decoration:none">thehootlabmedia.com</a></p>
</td></tr>
</table>
</td></tr>
</table>
</body></html>`;

  const logo = Utilities.newBlob(
    Utilities.base64Decode(LOGO_B64),
    "image/png",
    "logo.png"
  );

  MailApp.sendEmail({
    to: CONFIG.NOTIFY_EMAIL,
    subject: `${emoji} ${badge} — ${who}`,
    htmlBody: html,
    replyTo: data.email || CONFIG.NOTIFY_EMAIL,
    name: "The HootLab Media",
    inlineImages: { hootlablogo: logo },
  });
}

/* ── 3. WhatsApp (GREEN-API) ─────────────────────────────── */
function sendWhatsApp(type, data) {
  if (!CONFIG.GREENAPI_ID_INSTANCE || !CONFIG.GREENAPI_API_TOKEN || !CONFIG.WHATSAPP_PHONE) return;

  let msg;
  if (type === "brand") {
    msg =
      `🏢 New BRAND enquiry — HootLab\n` +
      `Name: ${data.first_name || ""} ${data.last_name || ""}\n` +
      `Company: ${data.company || "-"}\n` +
      `Email: ${data.email || "-"}\n` +
      `Phone: ${data.phone || "-"}\n` +
      `Budget: ${data.budget || "-"}`;
  } else {
    msg =
      `🎬 New INFLUENCER — HootLab\n` +
      `Name: ${data.influencer_name || "-"}\n` +
      `Contact: ${data.contact_number || "-"}\n` +
      `IG: ${data.instagram_followers || "-"} | YT: ${data.youtube_followers || "-"}\n` +
      `Type: ${data.collab_type || "-"} | ${data.category || "-"}\n` +
      `City: ${data.city || "-"}, ${data.state || "-"}`;
  }

  const url =
    "https://api.green-api.com/waInstance" + CONFIG.GREENAPI_ID_INSTANCE +
    "/sendMessage/" + CONFIG.GREENAPI_API_TOKEN;
  const payload = {
    chatId: String(CONFIG.WHATSAPP_PHONE).replace(/\D/g, "") + "@c.us",
    message: msg,
  };
  UrlFetchApp.fetch(url, {
    method: "post",
    contentType: "application/json",
    payload: JSON.stringify(payload),
    muteHttpExceptions: true,
  });
}

